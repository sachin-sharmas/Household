NODE_ENV=development
PORT=5000
# Allowed frontend origin(s) for CORS - comma-separate to allow several
CLIENT_URL=https://household-six-blush.vercel.app
# Public URL of this API. When set, the server pings itself every 10 minutes to
# stay awake on free-tier hosts. On Render this is auto-detected (RENDER_EXTERNAL_URL).
KEEP_ALIVE_URL=
JWT_SECRET=change-this-secret
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
COOKIE_SECURE=true
# Browser push notifications (generate a pair with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
ADMIN_EMAIL=admin@grocery.com
ADMIN_PASSWORD=Admin@12345
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# SMTP is required for password reset emails and item-assignment emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Household Grocery <no-reply@yourdomain.com>
